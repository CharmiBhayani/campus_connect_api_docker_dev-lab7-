            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Distributed Systems Principles\",\n  \"description\": \"Updated 2nd Edition\",\n  \"category\": \"Books\",\n  \"price\": 649.00,\n  \"stock\": 30\n}"
