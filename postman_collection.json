      ]
    },
    {
      "name": "4. Order Service (via Gateway)",
      "item": [
        {
          "name": "GET /orders – List All Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders",
            "description": "Routed via Gateway: GET /orders -> Order Service"
          }
        },
        {
          "name": "POST /orders – Create Order (Full Chain)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData._id) {",
                  "    pm.collectionVariables.set('orderId', jsonData._id);",
                  "    console.log('Saved orderId:', jsonData._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "GET /orders/:id – Fetch Order by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "POST /orders – Invalid User ID (404)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"000000000000000000000000\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Gateway Error Handling (502/503)",
      "item": [
        {
          "name": "GET /users – Unreachable Service (503 Service Unavailable)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users",
            "description": "Executed when User Service container/process is stopped to verify centralized 503 response from Gateway."
          }
        },
        {
          "name": "GET /unmapped – Unmapped Route (404 Not Handled)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/unknown-service-path",
            "description": "Verifies that unmapped gateway routes return clear 404 response."
          }
        }
      ]
    }
  ]
}
