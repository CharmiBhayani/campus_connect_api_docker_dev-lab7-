{
  "info": {
    "name": "Microservices & API Gateway - Lab 7",
    "_postman_id": "lab7-campus-connect-gateway",
    "description": "Lab 7: CampusConnect API Gateway, Service Discovery & Cloud Deployment. Single entry point for all microservices with centralized logging, error handling, and externalized configuration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. API Gateway Health & Discovery",
      "item": [
        {
          "name": "GET /health – Gateway Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Gateway health-check reporting status, uptime, and active service discovery routing table."
          }
        },
        {
          "name": "GET / – Gateway Metadata",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "description": "Root endpoint describing the API Gateway and available routes."
          }
        }
      ]
    },
    {
      "name": "2. User Service (via Gateway)",
      "item": [
        {
          "name": "GET /users – List All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users",
            "description": "Routed via Gateway: GET /users -> User Service"
          }
        },
        {
          "name": "POST /users – Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData._id) {",
                  "    pm.collectionVariables.set('userId', jsonData._id);",
                  "    console.log('Saved userId:', jsonData._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Kumar\",\n  \"email\": \"alice@campus.edu\",\n  \"course\": \"Computer Science\",\n  \"semester\": 3,\n  \"role\": \"student\"\n}"
            }
          }
        },
        {
          "name": "GET /users/:id – Fetch User by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "GET /users/:id – Invalid ID (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/000000000000000000000000"
          }
        },
        {
          "name": "PUT /users/:id – Update User",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Kumar\",\n  \"email\": \"alice@campus.edu\",\n  \"course\": \"Computer Science\",\n  \"semester\": 4,\n  \"role\": \"student\"\n}"
            }
          }
        },
        {
          "name": "DELETE /users/:id – Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
